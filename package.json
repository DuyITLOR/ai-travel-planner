{
  "name": "ai-travel-planner",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter @atp/web dev",
    "dev:api": "pnpm --filter @atp/api dev",
    "board": "node docs/board-server.mjs",
    "build": "pnpm -r build",
    "lint": "eslint . && pnpm --filter @atp/api lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write . && pnpm --filter @atp/api format",
    "format:check": "prettier --check . && pnpm --filter @atp/api format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
