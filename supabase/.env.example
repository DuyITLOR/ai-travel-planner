# Sao chép thành supabase/.env (đã gitignore) trước khi chạy `supabase start`.
# OAuth client "Web application" ở Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
