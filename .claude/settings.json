{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm dev)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(cargo fmt:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Edit(apps/**)",
      "Edit(packages/**)",
      "Edit(docs/**)"
    ],
    "ask": [
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(cargo add:*)",
      "Bash(cargo remove:*)",
      "Bash(supabase migration new:*)",
      "Bash(supabase db push:*)",
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Edit(.github/**)",
      "Edit(render.yaml)",
      "Edit(supabase/migrations/**)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/**)",
      "Edit(apps/api/tests/**)",
      "Edit(packages/shared/test/**)",
      "Edit(apps/web/**/*.test.ts)",
      "Edit(apps/api/src/plans/validator.rs)",
      "Edit(docs/contract/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(grep *.env*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(supabase db reset --linked:*)",
      "Bash(rm -rf:*)",
      "Bash(git push -u origin main)",
      "Bash(git push --set-upstream origin main)",
      "Bash(git push origin --force:*)"
    ]
  }
}
