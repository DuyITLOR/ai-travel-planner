# Sao chép thành .env rồi điền. KHÔNG commit file .env.
# Mặc định 4000.
PORT=
# Origin của web được gọi api, nhiều giá trị cách nhau bằng dấu phẩy. Mặc định http://localhost:3000.
WEB_ORIGIN=
# Mặc định atp_api=info,tower_http=info. Khi debug: atp_api=debug,tower_http=info
RUST_LOG=

# Postgres của Supabase. Để trống thì api vẫn chạy, /health báo db = not_configured.
#
# Project trên cloud: Dashboard → nút Connect → chọn "Session pooler" (cổng 5432), dạng:
#   postgresql://postgres.<project-ref>:<mật khẩu>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Không dùng "Transaction pooler" (cổng 6543): chế độ đó không hỗ trợ prepared statement của sqlx.
#
# Chạy local bằng `supabase start` (cần Docker):
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Supabase Auth: Dashboard → Project Settings → API → JWT Settings → "JWT Secret" (HS256).
# Dùng để kiểm tra access token ở các endpoint cần đăng nhập (vd POST /plans/{planId}/save).
# Để trống thì api vẫn chạy nhưng mọi request cần đăng nhập nhận 401.
SUPABASE_JWT_SECRET=

# ---- Model (dùng từ PA#3; chỉ backend đọc, KHÔNG BAO GIỜ đặt trong apps/web hay NEXT_PUBLIC_*) ----
# Model chính: Qwen qua Ollama trên máy demo, mở ra ngoài bằng Cloudflare Tunnel.
OLLAMA_BASE_URL=
# vd qwen2.5:7b
OLLAMA_MODEL=
# Token bí mật gửi kèm mỗi request tới tunnel để người ngoài không dùng ké model.
OLLAMA_TUNNEL_TOKEN=
# Dự phòng: Gemini (Google AI Studio). Spending cap: xem mục "Model và spending cap" trong README.
GEMINI_API_KEY=
# vd gemini-3.5-flash-lite
GEMINI_MODEL=

# Commit đang chạy, hiện trong /health. Render tự đặt khi deploy; local để trống (hiện "local").
RENDER_GIT_COMMIT=
