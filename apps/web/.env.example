# Sao chép thành .env.local.
# Mặc định http://localhost:4000.
NEXT_PUBLIC_API_URL=

# Supabase: Dashboard → Project Settings → API (hoặc nút Connect).
# Hai giá trị này công khai theo thiết kế, dữ liệu được bảo vệ bằng Row Level Security.
# Chạy local bằng `supabase start` thì URL là http://127.0.0.1:54321, key lấy từ `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin công khai của web, dùng làm link quay về sau khi đăng nhập Google / xác nhận email.
# Để trống thì lấy từ header Host. Trên Vercel đặt https://<domain>.
# URL này (kèm /auth/callback) phải nằm trong Supabase → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=
