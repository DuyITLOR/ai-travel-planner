# Sao chép thành .env.local.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase: Dashboard → Project Settings → API (hoặc nút Connect).
# Hai giá trị này công khai theo thiết kế, dữ liệu được bảo vệ bằng Row Level Security.
# Chạy local bằng `supabase start` thì URL là http://127.0.0.1:54321, key lấy từ `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
